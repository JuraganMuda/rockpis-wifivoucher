# =================================================================
# RTNA Wi-Fi Voucher System - Environment Variables Template
# =================================================================
# Salin file ini menjadi '.env' di server Anda:
# cp .env.example .env
# =================================================================

# Cloudflare Zero Trust Tunnel Token
# Dapatkan token ini dari Cloudflare Zero Trust Dashboard:
# Networks -> Tunnels -> Create a Tunnel (Cloudflared)
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...your_token_here...

# Kunci API & Keamanan Internal
# Digunakan untuk integrasi webhook Google AppSheet & sinkronisasi
API_KEY=rahasia-appsheet-123

# PIN Akses Portal Admin Web (/admin.html)
ADMIN_PIN=123456

# Konfigurasi Database MariaDB
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=radius_db
MYSQL_USER=radius
MYSQL_PASSWORD=radius_password
DB_HOST=127.0.0.1
DB_PORT=3306
